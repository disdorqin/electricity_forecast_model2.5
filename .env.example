# ============================================================
# Database configuration for sync_dataset pipeline
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to Git — it is already in .gitignore.
# ============================================================

DB_HOST=
DB_PORT=3306
DB=
DB_USER=
DB_PWD=

# Optional: select the production unit when epf_pmos_96_full contains more than one unit_id.
# If the table contains exactly one unit, the 96-point sync auto-selects it.
PMOS_96_UNIT_ID=

# Optional: custom data path used by the legacy 24-point sync_dataset path.
DATA_SET_NAME=data/shandong_pmos_hourly.xlsx
