# Local data files (tracked in git historically, now ignored)
data/
ExtremPriceClf/data/

# Tooling local state (not part of the project)
.claude/
.workbuddy/
chrome_profile/
node_modules/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyc
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env
.env
.venv/
venv/
venv_build/

# Large artifacts
models/
# outputs 整体忽略，但平台复盘数据集单独放行（outputs/platform_review/ 进 git）
outputs/*
!outputs/platform_review/
!outputs/platform_review/**
logs/
checkpoints/
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.npy
*.npz

# Archives & run outputs (kept locally, not in repo)
fusion_runs/
daily_runs/
daily_runs_*/
ExtremPriceClf/daily_runs/

# Ad-hoc scripts & outputs (not part of the project)
run_*.py
# Allow the release entry point
!run_one_day_release.py
# Allow the crawler entry point
!scripts/crawler/run_crawler.py
# Allow the extreme price classifier daily entry (needed by classifier_bridge)
!ExtremPriceClf/merge_model_scripts/run_daily.py
run_*.bat
launch_*.py
compute_*.py
_test_*/

# PyInstaller builds
*.exe
*.spec
!scripts/auto_crawler/portable_onedir.spec
build/
dist/
pyi_tmp/

# Shareable crawler release package: keep only the selected executable and the
# public config template; runtime credentials, logs, HAR and output data under
# dist/crawler remain ignored.
!dist/
dist/*
!dist/crawler/
dist/crawler/*
!dist/crawler/crawl_96_auto_v3.exe
!dist/crawler/config.example.json

# Temp
_tmp_*.py
debug.log
*.log
scripts/auto_crawler/config.json

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# 实验脚本放行（跑实验用，产物仍进 outputs/experiments）
!scripts/experiments/
!scripts/experiments/**
scripts/experiments/**/__pycache__/
scripts/experiments/**/*.pyc

scripts/crawler/config.json
